@startuml program_flow
title Environment Datalogger - Program Flow (real HW / Deep Sleep variant)

start
:Power on or wake from Deep Sleep;
:Serial.begin(115200);
:bootCount++;
if (wake cause == TIMER?) then (yes)
  :uptimeS += SLEEP_INTERVAL_S;
else (cold boot)
  :uptimeS = 0;
endif
:Print boot banner +\nwake cause + counters;

:pinMode AWAKE, ACTIVITY LEDs;
:AWAKE LED -> HIGH;
:dht.begin();
if (cold boot?) then (yes)
  :delay 800 ms\nDHT22 settling time;
else (no)
endif

partition "Acquisition" {
  :ACTIVITY LED -> HIGH;
  :readDht() with one retry;
  if (valid?) then (yes)
    :buffer[bufferCount] = {uptimeS, t, h};
    :bufferCount++;
    :totalReadings++;
    :log [READ n/10] t=.. h=..;
  else (no)
    :log [ERROR] DHT failed;
  endif
  :delay(ACTIVITY_PULSE_MS);
  :ACTIVITY LED -> LOW;
}

if (bufferCount >= 10?) then (yes)
  :dumpAndReset()\nprint 10-row table\nbufferCount = 0;
else (no)
endif

:log [SLEEP] entering Deep Sleep;
:Serial.flush();
:AWAKE LED -> LOW;
:esp_sleep_enable_timer_wakeup(60s);
:esp_deep_sleep_start();
note right: never returns;\nchip wakes via reset

stop

@enduml
